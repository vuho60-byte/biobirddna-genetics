{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biobirddna.local/schemas/inheritance-model.schema.json",
  "title": "BioBirdDNA inheritance model",
  "description": "Runtime invariant: normal_label and target_label must differ; incomplete_dominant also requires intermediate_label to differ from both.",
  "x-cross-field-invariants": [
    "normal_label != target_label",
    "mode == incomplete_dominant => intermediate_label distinct from normal_label and target_label"
  ],
  "type": "object",
  "required": ["model_id", "mode"],
  "additionalProperties": false,
  "properties": {
    "model_id": {"type": "string", "minLength": 1},
    "mode": {
      "enum": [
        "autosomal_recessive",
        "autosomal_dominant",
        "incomplete_dominant",
        "z_linked_recessive",
        "z_linked_dominant",
        "non_genetic"
      ]
    },
    "normal_allele": {"type": "string", "default": "N"},
    "variant_allele": {"type": "string", "default": "m"},
    "normal_label": {"type": "string", "default": "normal"},
    "target_label": {"type": "string", "default": "target_colour"},
    "intermediate_label": {"type": "string", "default": "intermediate"},
    "penetrance": {"type": "number", "minimum": 0, "maximum": 1},
    "observation_error": {"type": "number", "minimum": 0, "maximum": 1},
    "female_probability": {"type": "number", "minimum": 0, "maximum": 1},
    "baseline_target_probability": {"type": "number", "minimum": 0, "maximum": 1},
    "description": {"type": "string"}
  }
}
