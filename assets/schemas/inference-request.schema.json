{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biobirddna.local/schemas/inference-request.schema.json",
  "title": "BioBirdDNA inference request",
  "type": "object",
  "required": ["male_parent_phenotype", "female_parent_phenotype", "offspring"],
  "properties": {
    "target_label": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "male_parent_phenotype": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "female_parent_phenotype": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "models": {
      "type": "array",
      "items": {"$ref": "inheritance-model.schema.json"},
      "minItems": 2,
      "uniqueItems": true,
      "$comment": "Runtime additionally enforces uniqueness by model_id.",
      "contains": {
        "type": "object",
        "required": ["model_id", "mode"],
        "properties": {
          "model_id": {"const": "M0_NONGENETIC"},
          "mode": {"const": "non_genetic"}
        }
      },
      "minContains": 1,
      "maxContains": 1
    },
    "model_priors": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0}
    },
    "offspring": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["phenotype", "count"],
        "properties": {
          "sex": {
            "enum": ["male", "female", "unknown"],
            "default": "unknown"
          },
          "phenotype": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:.*\\S)?$"
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
